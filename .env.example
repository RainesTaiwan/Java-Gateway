# 複製為 .env 後填入真實值：cp .env.example .env
# .env 已被 .gitignore 忽略，不會推到 GitHub。

TELEGRAM_BOT_USERNAME=your_bot_username
TELEGRAM_BOT_TOKEN=
ALLOWED_TELEGRAM_USER_ID=
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=
PROJECT_ID=
PROJECT_STATUS_FIELD_ID=
PROJECT_STATUS_IN_PROGRESS_OPTION_ID=
PROJECT_STATUS_VERIFYING_OPTION_ID=
PROJECT_STATUS_RETRYING_OPTION_ID=
PROJECT_STATUS_DONE_OPTION_ID=
PROJECT_STATUS_FAILED_OPTION_ID=

# JMS 佇列名稱；對應 application.yml 的 app.jms.command-queue。
APP_JMS_COMMAND_QUEUE=dev.command.queue

# LocalTunnel 嘗試固定使用 https://<subdomain>.loca.lt（全球共用，名稱越唯一越好）。
# 建議格式：raines-jgw-<你的GitHubID或隨機字串>
LOCALTUNNEL_SUBDOMAIN=raines-jgw-change-me

# Ollama 啟動時自動確保此模型存在；4GB VRAM 建議先用小模型。
OLLAMA_MODEL=qwen2.5-coder:1.5b
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_TIMEOUT_SECONDS=20

# Orchestrator JGit / 開發引擎沙盒設定。
GIT_REPOSITORY_URI=https://github.com/your-org/your-repo.git
GIT_BRANCH=main
ORCHESTRATOR_WORKSPACE_CONTAINER_PATH=/app/workspace
ORCHESTRATOR_WORKSPACE_HOST_PATH=/home/raines/git/Java Gateway/workspace
DOCKER_NETWORK_NAME=javagateway_default
AGENT_ENGINE=cursor
AGENT_TIMEOUT_SECONDS=300

# Cursor（預設）：Dashboard → Integrations 建立 API Key
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5
CURSOR_RUNNER_IMAGE=java-gateway-cursor-runner:latest

# Aider（AGENT_ENGINE=aider 時使用）
AIDER_IMAGE=paulgauthier/aider:latest
AIDER_MODEL=anthropic/claude-3-5-sonnet-20241022
CLAUDE_API_KEY=

# git push 前獨立 TestRunner 驗證階段。
TEST_RUNNER_IMAGE=maven:3.9-eclipse-temurin-17-alpine
TEST_RUNNER_TIMEOUT_SECONDS=180
